---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { niveau: '5eme' }, props: { label: '5ème' } },
    { params: { niveau: '4eme' }, props: { label: '4ème' } },
  ];
}

const { niveau } = Astro.params;
const { label } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const acts = (await getCollection('activites'))
  .filter(a => a.data.niveau === niveau)
  .sort((a, b) => a.data.code.localeCompare(b.data.code));
---
<Base titre={`${label} — Séquence 05 Conception`} description={`Activités de Technologie ${label}, séquence Conception.`}>
  <section class="hero">
    <span class="cote">{label} · SÉQUENCE 05</span>
    <h1>Conception</h1>
    <p>{acts.length} activités, de l'analyse du besoin à la fabrication.</p>
  </section>

  <ul class="liste">
    {acts.map(a => (
      <li>
        <a href={`${base}/${a.data.annee}/${a.data.seq}/${a.id}`}>
          <span class="code">{a.data.code}</span>
          <span class="titre">{a.data.titre}</span>
          <span class="semaine">{a.data.semaine}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
