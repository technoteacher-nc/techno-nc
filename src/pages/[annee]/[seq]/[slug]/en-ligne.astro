---
// Fiche remplissable en ligne — la version « je travaille directement ici »
// de la fiche papier. Aucun compte, aucun envoi : les réponses restent dans le
// navigateur de l'élève (localStorage), conformément à la promesse du pied de
// page (« aucun compte, aucun cookie, aucun traceur »).
//
// C'est la seule page du site qui embarque du JavaScript. Elle le justifie :
// sans lui il n'y a ni sauvegarde ni reprise après une coupure réseau — et la
// coupure réseau est la norme, pas l'exception (voir PRODUCT.md).
// Le rendu, lui, est entièrement statique : la fiche est lisible et
// imprimable même si le script ne s'exécute jamais.

import Base from '../../../../layouts/Base.astro';
import FicheEnLigne from '../../../../components/FicheEnLigne.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const acts = await getCollection('activites');
  const dossier = path.join(process.cwd(), 'src', 'data', 'fiches');
  return acts
    .filter(a => fs.existsSync(path.join(dossier, a.id + '.json')))
    .map(a => {
      // Le corrigé voyage CHIFFRÉ dans la page (tools/gen-corriges-eleves.cjs).
      // Inline plutôt qu'en requête séparée : il reste disponible une fois la
      // page chargée, y compris si la connexion tombe ensuite.
      const chemin = path.join(process.cwd(), 'src', 'data', 'corriges', a.id + '.json');
      return {
        params: { annee: a.data.annee, seq: a.data.seq, slug: a.id },
        props: {
          act: a,
          fiche: JSON.parse(fs.readFileSync(path.join(dossier, a.id + '.json'), 'utf8')),
          corrige: fs.existsSync(chemin) ? fs.readFileSync(chemin, 'utf8') : null,
        },
      };
    });
}

const { act, fiche, corrige } = Astro.props;
const d = act.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = p => base + p;
const retour = u(`/${d.annee}/${d.seq}/${act.id}`);
---
<Base
  titre={`${d.code} ${d.niveauLabel} — ${d.titre}, à remplir en ligne`}
  description={`Remplis l'activité « ${d.titre} » directement en ligne : tes réponses sont enregistrées sur ton appareil, sans compte.`}
  robots="index,follow">

  <nav class="fil" aria-label="Fil d'Ariane">
    <a href={u('/')}>Accueil</a> / <a href={u('/' + d.niveau)}>{d.niveauLabel}</a> /
    <a href={retour}>{d.code}</a> / En ligne
  </nav>

  <header class="act-tete fl-tete">
    <div class="act-repere">
      {d.phase && <span class="phase" data-phase={d.phase}>{d.phase}</span>}
      <span class="eyebrow-mini">{d.seqTitre} · {d.niveauLabel}</span>
    </div>
    <h1>{d.titre}</h1>
    <p class="question">{d.question}</p>
  </header>

  <!-- Barre d'état : tout ce que l'élève doit savoir sur ses réponses.
       Statique et honnête si le script ne tourne pas. -->
  <div class="fl-barre" id="fl-barre" data-fiche={act.id}>
    <div class="fl-barre-etat">
      <span class="fl-pastille" id="fl-pastille" aria-hidden="true"></span>
      <p id="fl-etat">
        Tes réponses restent <strong>sur cet appareil</strong>. Rien n'est envoyé, aucun compte.
      </p>
    </div>
    <div class="fl-barre-actions">
      <button type="button" class="btn" id="fl-imprimer">Imprimer<span class="btn-meta">ou PDF</span></button>
      <button type="button" class="btn" id="fl-word">Exporter<span class="btn-meta">Word</span></button>
      <button type="button" class="btn" id="fl-enregistrer">Sauvegarder<span class="btn-meta">pour reprendre</span></button>
      <label class="btn" for="fl-reprendre">Reprendre<span class="btn-meta">un fichier</span></label>
      <button type="button" class="btn" id="fl-copier">Copier mes réponses</button>
      <input type="file" id="fl-reprendre" accept=".json,application/json" hidden />
      <button type="button" class="btn fl-btn-danger" id="fl-effacer">Tout effacer</button>
    </div>
    <p class="fl-progres" id="fl-progres" hidden></p>

    {corrige && (
      <div class="fl-corrige-zone">
        <button type="button" class="btn fl-btn-corrige" id="fl-voir-corrige">
          Voir la correction<span class="btn-meta">mot donné en classe</span>
        </button>
        <form class="fl-corrige-form" id="fl-corrige-form" hidden>
          <label for="fl-motdepasse">Mot de passe de l'activité</label>
          <input type="text" id="fl-motdepasse" autocomplete="off" autocapitalize="none"
                 spellcheck="false" placeholder="ex. lagon-204-banian" />
          <button type="submit" class="btn btn--fort">Ouvrir</button>
          <p class="fl-corrige-msg" id="fl-corrige-msg" role="status"></p>
        </form>
      </div>
    )}
  </div>

  {corrige && <script type="application/json" id="fl-corrige-donnees" set:html={corrige} />}

  <!-- Une seule ligne d'identité, imprimée seulement si elle est remplie :
       le bandeau NOM/PRÉNOM/CLASSE/MAISON de la fiche papier mangeait une
       zone de réponse entière pour une information que le professeur connaît
       déjà dans neuf cas sur dix. -->
  <div class="fl-identite">
    <label for="fl-nom">Ton nom <span>(seulement si tu imprimes pour rendre)</span></label>
    <!-- placeholder vide : permet à la règle d'impression de masquer la ligne
         quand l'élève ne l'a pas remplie (:placeholder-shown) -->
    <input type="text" id="fl-nom" data-champ={`${d.code}-identite`} autocomplete="name" placeholder=" " />
  </div>

  <article class="fl-fiche" id="fl-fiche">
    <FicheEnLigne blocs={fiche.blocs} code={d.code} />
  </article>

  <section class="fl-pied">
    <a class="btn btn--fort" href={u(d.fichePdf)} download>Version papier (PDF)</a>
    {d.ebepPdf && <a class="btn" href={u(d.ebepPdf)} download>Version adaptée (PDF)</a>}
    <a class="btn" href={retour}>Retour à l'activité</a>
  </section>

  <script>
    // Sauvegarde locale des réponses. Volontairement court et sans dépendance :
    // il doit s'exécuter avant que l'élève ait fini de lire la première consigne,
    // y compris sur un téléphone d'entrée de gamme en 3G.
    const barre = document.getElementById('fl-barre');
    if (barre) {
      const cle = 'techno-nc:' + barre.dataset.fiche;
      const champs = [...document.querySelectorAll('[data-champ]')];
      const etat = document.getElementById('fl-etat');
      const pastille = document.getElementById('fl-pastille');
      const progres = document.getElementById('fl-progres');

      const lire = () => {
        try { return JSON.parse(localStorage.getItem(cle) || '{}'); } catch { return {}; }
      };

      // --- restauration
      const donnees = lire();
      let restaure = 0;
      for (const el of champs) {
        const v = donnees[el.dataset.champ];
        if (v === undefined) continue;
        if (el.type === 'checkbox') el.checked = !!v;
        else el.value = v;
        restaure++;
      }

      const remplis = () => champs.filter(
        el => el.type === 'checkbox' ? el.checked : el.value.trim() !== '',
      ).length;

      const majProgres = () => {
        progres.hidden = false;
        progres.textContent = `${remplis()} réponse(s) sur ${champs.length} — enregistré sur cet appareil.`;
      };

      let horloge;
      const enregistrer = () => {
        const o = {};
        for (const el of champs) {
          const v = el.type === 'checkbox' ? el.checked : el.value;
          if (v !== '' && v !== false) o[el.dataset.champ] = v;
        }
        try {
          localStorage.setItem(cle, JSON.stringify(o));
          pastille.dataset.etat = 'ok';
          etat.innerHTML = 'Enregistré <strong>sur cet appareil</strong> — tu peux fermer la page et revenir.';
        } catch {
          pastille.dataset.etat = 'ko';
          etat.textContent = "Impossible d'enregistrer (navigation privée ?). Imprime ta fiche avant de fermer.";
        }
        majProgres();
      };

      // Les zones de texte grandissent avec la réponse : plus jamais de manque de place.
      const ajuster = el => {
        if (el.tagName !== 'TEXTAREA') return;
        el.style.height = 'auto';
        el.style.height = el.scrollHeight + 'px';
      };
      champs.forEach(ajuster);

      for (const el of champs) {
        el.addEventListener('input', () => {
          ajuster(el);
          clearTimeout(horloge);
          horloge = setTimeout(enregistrer, 400);
        });
        el.addEventListener('change', enregistrer);
      }

      if (restaure) { pastille.dataset.etat = 'ok'; majProgres(); }

      document.getElementById('fl-imprimer').addEventListener('click', () => window.print());

      document.getElementById('fl-effacer').addEventListener('click', () => {
        if (!confirm('Effacer toutes tes réponses de cette fiche ? C\'est définitif.')) return;
        localStorage.removeItem(cle);
        for (const el of champs) {
          if (el.type === 'checkbox') el.checked = false; else el.value = '';
          ajuster(el);
        }
        pastille.removeAttribute('data-etat');
        etat.innerHTML = 'Réponses effacées. Tes réponses restent <strong>sur cet appareil</strong>.';
        majProgres();
      });

      // Enregistrer / reprendre un fichier.
      //
      // Le stockage local est attaché à UNE machine. Au collège les postes sont
      // partagés : un élève qui change de salle ou de poste ne retrouve rien.
      // Le fichier règle ça, et il le règle avec ce que la séquence 03 vient
      // justement d'enseigner — on l'enregistre dans son espace personnel, sur
      // le serveur, et il suit l'élève d'un poste à l'autre.
      const nomFichier = () => {
        // Les accents sont translittérés plutôt que supprimés : sans cela
        // « Léna » donnait le fichier « L-NA », que l'élève ne reconnaît pas.
        const nom = (document.getElementById('fl-nom').value || '').trim()
          .normalize('NFD').replace(/[̀-ͯ]/g, '')
          .toUpperCase().replace(/[^A-Z0-9]+/g, '-').replace(/^-|-$/g, '');
        return (nom ? nom + '_' : '') + barre.dataset.fiche + '.json';
      };

      document.getElementById('fl-enregistrer').addEventListener('click', () => {
        const contenu = JSON.stringify({ fiche: barre.dataset.fiche, reponses: lire() }, null, 1);
        const lien = document.createElement('a');
        lien.href = URL.createObjectURL(new Blob([contenu], { type: 'application/json' }));
        lien.download = nomFichier();
        lien.click();
        URL.revokeObjectURL(lien.href);
      });

      document.getElementById('fl-reprendre').addEventListener('change', async (ev) => {
        const fichier = ev.target.files[0];
        if (!fichier) return;
        try {
          const donnees = JSON.parse(await fichier.text());
          if (donnees.fiche !== barre.dataset.fiche) {
            alert(`Ce fichier est celui d’une autre activité (${donnees.fiche}).
Ouvre la bonne activité, puis reprends ton fichier.`);
            return;
          }
          for (const el of champs) {
            const v = donnees.reponses[el.dataset.champ];
            if (v === undefined) continue;
            if (el.type === 'checkbox') el.checked = !!v; else el.value = v;
            ajuster(el);
          }
          enregistrer();
        } catch {
          alert("Ce fichier n'est pas lisible. Reprends celui que tu as enregistré depuis cette page.");
        }
        ev.target.value = '';
      });

      // Export Word.
      //
      // Le fichier de sauvegarde est du JSON : c'est ce qu'il faut pour que
      // « Reprendre un fichier » retrouve chaque réponse à sa place, mais ça ne
      // s'ouvre pas dans un traitement de texte. Pour rendre ou archiver son
      // travail, l'élève a besoin d'un document lisible — d'où cet export.
      // Word ouvre nativement un fichier HTML portant l'extension .doc :
      // aucune bibliothèque à charger, et le rendu conserve les tableaux.
      document.getElementById('fl-word').addEventListener('click', () => {
        const copie = document.getElementById('fl-fiche').cloneNode(true);

        // Les champs de saisie deviennent du texte : un <input> ne s'imprime pas
        // dans Word, seule sa valeur compte.
        for (const el of copie.querySelectorAll('input, textarea')) {
          if (el.type === 'checkbox') {
            const marque = document.createElement('span');
            marque.textContent = el.checked ? '☑ ' : '☐ ';
            el.replaceWith(marque);
          } else {
            const texte = document.createElement('span');
            texte.className = 'rep';
            texte.textContent = el.value || '………';
            el.replaceWith(texte);
          }
        }
        for (const el of copie.querySelectorAll('.fl-attendu, .fl-note-prof')) el.remove();

        const nom = (document.getElementById('fl-nom').value || '').trim();
        const entete = `<h1>${document.querySelector('.act-tete h1').textContent}</h1>`
          + (nom ? `<p><b>${nom}</b></p>` : '');
        const style = 'body{font-family:Calibri,Arial,sans-serif;font-size:11pt;color:#000}'
          + 'h1{font-size:16pt}h2{font-size:14pt}h3{font-size:12pt;background:#eee;padding:4pt}'
          + 'table{border-collapse:collapse;width:100%}td,th{border:1px solid #999;padding:4pt;'
          + 'vertical-align:top}.rep{color:#0a3d8f;font-weight:bold}'
          + 'ul{margin:0;padding-left:14pt}';
        const doc = '<html xmlns:o="urn:schemas-microsoft-com:office:office" '
          + 'xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">'
          + `<head><meta charset="utf-8"><title>${document.title}</title><style>${style}</style></head>`
          + `<body>${entete}${copie.innerHTML}</body></html>`;

        const lien = document.createElement('a');
        lien.href = URL.createObjectURL(new Blob(['﻿' + doc], { type: 'application/msword' }));
        lien.download = nomFichier().replace(/\.json$/, '.doc');
        lien.click();
        URL.revokeObjectURL(lien.href);
      });

      // ------------------------------------------------------ la correction
      //
      // Le corrigé est chiffré dans la page : sans le mot donné en classe, il
      // n'y a rien à lire, même dans le code source. On le déchiffre ici, et
      // on affiche la réponse attendue À CÔTÉ de celle de l'élève — c'est la
      // comparaison qui fait apprendre, pas la réponse seule.
      const paquetEl = document.getElementById('fl-corrige-donnees');
      if (paquetEl) {
        const paquet = JSON.parse(paquetEl.textContent);
        const cleMot = 'techno-nc:mot:' + barre.dataset.fiche;
        const bouton = document.getElementById('fl-voir-corrige');
        const form = document.getElementById('fl-corrige-form');
        const saisie = document.getElementById('fl-motdepasse');
        const msg = document.getElementById('fl-corrige-msg');
        let affiche = false;

        const versOctets = t => Uint8Array.from(atob(t), c => c.charCodeAt(0));

        const dechiffrer = async (mot) => {
          const base = await crypto.subtle.importKey(
            'raw', new TextEncoder().encode(mot), 'PBKDF2', false, ['deriveKey']);
          const k = await crypto.subtle.deriveKey(
            { name: 'PBKDF2', salt: versOctets(paquet.sel), iterations: paquet.it, hash: 'SHA-256' },
            base, { name: 'AES-GCM', length: 256 }, false, ['decrypt']);
          const clair = await crypto.subtle.decrypt(
            { name: 'AES-GCM', iv: versOctets(paquet.iv) }, k, versOctets(paquet.charge));
          return JSON.parse(new TextDecoder().decode(clair));
        };

        const poser = (corrige) => {
          for (const el of champs) {
            const attendu = corrige.champs[el.dataset.champ];
            if (!attendu || el.nextElementSibling?.classList.contains('fl-attendu')) continue;
            const bulle = document.createElement('span');
            bulle.className = 'fl-attendu';
            bulle.dataset.type = el.tagName === 'TEXTAREA' ? 'bloc' : 'ligne';
            bulle.textContent = attendu;
            el.insertAdjacentElement('afterend', bulle);
          }
          for (const bloc of document.querySelectorAll('[data-partie]')) {
            const note = corrige.notes[bloc.dataset.partie];
            if (!note || bloc.nextElementSibling?.classList.contains('fl-note-prof')) continue;
            const p = document.createElement('p');
            p.className = 'fl-note-prof';
            p.innerHTML = '<strong>À retenir —</strong> ';
            p.append(note);
            bloc.insertAdjacentElement('afterend', p);
          }
          document.getElementById('fl-fiche').classList.add('fl-fiche--corrigee');
          affiche = true;
          bouton.textContent = 'Masquer la correction';
          form.hidden = true;
        };

        const basculer = () => {
          affiche = !affiche;
          document.getElementById('fl-fiche').classList.toggle('fl-fiche--corrigee', affiche);
          bouton.textContent = affiche ? 'Masquer la correction' : 'Afficher la correction';
        };

        const ouvrir = async (mot, silencieux) => {
          try {
            const corrige = await dechiffrer(mot);
            // Le mot est celui de toute la classe : le garder évite de le
            // ressaisir à chaque visite. Il n'ouvre que CETTE activité.
            localStorage.setItem(cleMot, mot);
            poser(corrige);
            msg.textContent = '';
            return true;
          } catch {
            if (!silencieux) {
              msg.textContent = "Ce mot de passe n'ouvre pas cette activité. Vérifie les tirets, "
                + "et qu'il s'agit bien du mot de CETTE fiche.";
              msg.dataset.etat = 'ko';
            }
            return false;
          }
        };

        bouton.addEventListener('click', () => {
          if (affiche || document.querySelector('.fl-attendu')) { basculer(); return; }
          form.hidden = !form.hidden;
          if (!form.hidden) saisie.focus();
        });

        form.addEventListener('submit', async (ev) => {
          ev.preventDefault();
          const mot = saisie.value.trim().toLowerCase();
          if (!mot) return;
          msg.dataset.etat = '';
          msg.textContent = 'Ouverture…';
          await ouvrir(mot, false);
        });

        // Déjà ouvert lors d'une visite précédente : on rétablit sans rien demander.
        const memorise = localStorage.getItem(cleMot);
        if (memorise) ouvrir(memorise, true);
      }

      // « Copier mes réponses » : de quoi coller son travail dans l'ENT, un mail
      // ou un traitement de texte quand le professeur demande un rendu numérique.
      document.getElementById('fl-copier').addEventListener('click', async (ev) => {
        const lignes = [document.title, ''];
        for (const el of document.querySelectorAll('#fl-fiche .fl-partie, [data-champ]')) {
          if (el.classList.contains('fl-partie')) { lignes.push('', '## ' + el.textContent.trim()); continue; }
          const v = el.type === 'checkbox' ? (el.checked ? 'oui' : '') : el.value.trim();
          if (!v) continue;
          const contexte = el.closest('li, p, td, section')?.textContent.trim().slice(0, 90) || '';
          lignes.push('- ' + (contexte ? contexte + ' → ' : '') + v);
        }
        const texte = lignes.join('\n');
        try {
          await navigator.clipboard.writeText(texte);
          ev.target.textContent = 'Copié !';
        } catch {
          ev.target.textContent = 'Copie impossible';
        }
        setTimeout(() => { ev.target.textContent = 'Copier mes réponses'; }, 2200);
      });
    }
  </script>
</Base>
