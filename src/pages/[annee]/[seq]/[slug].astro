---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { simulateursDe, motsDe } from '../../../data/ressources';
import { notionsDe } from '../../../data/consolidation';
import { statSync, existsSync } from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const acts = await getCollection('activites');
  return acts.map(a => {
    const freres = acts
      .filter(x => x.data.niveau === a.data.niveau && x.data.seq === a.data.seq)
      .sort((x, y) => x.data.code.localeCompare(y.data.code));
    const i = freres.findIndex(x => x.id === a.id);
    return {
      params: { annee: a.data.annee, seq: a.data.seq, slug: a.id },
      props: { act: a, prec: freres[i - 1] ?? null, suiv: freres[i + 1] ?? null, rang: i + 1, total: freres.length },
    };
  });
}

const { act, prec, suiv, rang, total } = Astro.props;
const d = act.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = p => base + p;

// Poids d'un document de public/, mesuré au build : affiché sur le bouton
// pour que l'élève sache ce qu'il télécharge (connexions lentes).
function poids(rel) {
  if (!rel) return null;
  try {
    const octets = statSync(path.join(process.cwd(), 'public', rel)).size;
    return octets >= 1048576
      ? (octets / 1048576).toFixed(1).replace('.', ',') + ' Mo'
      : Math.max(1, Math.round(octets / 1024)) + ' Ko';
  } catch { return null; }
}
const pFiche = poids(d.fichePdf), pEbep = poids(d.ebepPdf), pDocx = poids(d.ficheDocx);

// Une version remplissable en ligne n'existe que si l'extraction du DOCX a
// abouti (tools/extraire-fiches.cjs) : le bouton ne s'affiche que dans ce cas.
const aFicheEnLigne = existsSync(path.join(process.cwd(), 'src', 'data', 'fiches', act.id + '.json'));

// Les animations qui parlent de CETTE activité. Proposées ici plutôt que dans
// un index : au moment où l'élève bloque, il est sur la fiche, pas sur la page
// Ressources.
const pourAllerPlusLoin = simulateursDe(act.id);

// Vingt-cinq fiches sur trente-sept portent « PROBLÉMATIQUE : » en tête de leur
// question, les douze autres non. Affiché tel quel à côté du « ? » de la mise
// en page, cela donnait « ? PROBLÉMATIQUE : Pourquoi… » — le mot double le
// pictogramme, et la moitié des pages ne l'avaient pas. On le retire à
// l'affichage plutôt que de retoucher vingt-cinq fichiers : la source reste
// libre, la page est uniforme.
const question = (d.question || '').replace(/^PROBL[ÉE]MATIQUE\s*:\s*/i, '');

// Le vocabulaire réellement mobilisé par CETTE activité, lexique et
// consolidation confondus. Mieux vaut trois mots au bon endroit qu'une liste
// de dix-huit définitions à trier soi-même.
const mots = motsDe(act.id);
const notions = notionsDe(act.id);

const urlPage = new URL(u(`/${d.annee}/${d.seq}/${act.id}`) + '/', Astro.site).href;
const donneesLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL(u('/'), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: d.niveauLabel, item: new URL(u('/' + d.niveau) + '/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: d.titre, item: urlPage },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: `${d.code} — ${d.titre}`,
    description: question,
    url: urlPage,
    inLanguage: 'fr',
    educationalLevel: d.niveauLabel,
    learningResourceType: "Fiche d'activité",
    isAccessibleForFree: true,
    license: 'https://creativecommons.org/licenses/by-nc-sa/4.0/',
    isPartOf: { '@type': 'Course', name: d.seqTitre },
    provider: { '@type': 'EducationalOrganization', name: "Collège d'Auteuil" },
  },
];
---
<Base titre={`${d.code} ${d.niveauLabel} — ${d.titre}`} description={question}>

  <script type="application/ld+json" slot="tete" set:html={JSON.stringify(donneesLd)} />

  <nav class="fil" aria-label="Fil d'Ariane">
    <a href={u('/')}>Accueil</a> / <a href={u('/' + d.niveau)}>{d.niveauLabel}</a> / <a href={u('/' + d.niveau) + '#' + d.seq}>{d.seqTitre}</a>
  </nav>

  <header class="act-tete leve">
    <div class="act-repere leve leve-1">
      {d.phase && <span class="phase" data-phase={d.phase}>{d.phase}</span>}
      <span class="eyebrow-mini">étape {rang} sur {total}{d.semaine && ` · ${d.semaine}`}</span>
    </div>
    <h1 class="leve leve-1">{d.titre}</h1>
    <p class="question leve leve-2">{question}</p>

    {/* La fiche papier passe en premier : c'est elle qu'on utilise en classe.
        Le remplissage en ligne reste offert, mais annoncé pour ce qu'il sert
        vraiment — rattraper une absence et relire la correction. */}
    <div class="docs leve leve-3">
      <a class="btn btn--fort" href={u(d.fichePdf)} download>
        Télécharger la fiche{pFiche && <span class="btn-meta">PDF · {pFiche}</span>}
      </a>
      {d.ebepPdf && <a class="btn" href={u(d.ebepPdf)} download>
        Version adaptée{pEbep && <span class="btn-meta">PDF · {pEbep}</span>}
      </a>}
      {aFicheEnLigne && <a class="btn" href={u(`/${d.annee}/${d.seq}/${act.id}/en-ligne`)}>
        Remplir en ligne<span class="btn-meta">rattrapage · correction</span>
      </a>}
      <a class="btn" href={u(d.ficheDocx)} download>
        Fiche modifiable{pDocx && <span class="btn-meta">DOCX · {pDocx}</span>}
      </a>
    </div>
  </header>

  {(d.objectif || d.competences.length || d.prerequis || d.materiel) && (
    <section class="meta" aria-label="Repères de l'activité">
      <dl>
        {d.objectif && <><dt>Objectif</dt><dd>{d.objectif}</dd></>}
        {d.competences.length > 0 && <><dt>Compétences</dt><dd><ul>{d.competences.map(c => <li>{c}</li>)}</ul></dd></>}
        {d.prerequis && <><dt>Prérequis</dt><dd>{d.prerequis}</dd></>}
        {d.materiel && <><dt>Matériel</dt><dd>{d.materiel}</dd></>}
      </dl>
    </section>
  )}

  {(mots.length > 0 || notions.length > 0) && (
    <section class="mots-cles" aria-labelledby="mots-cles-titre">
      <h2 id="mots-cles-titre">Le vocabulaire de cette activité</h2>
      {mots.length > 0 && (
        <dl class="mots-liste">
          {mots.map(m => (<><dt>{m.mot}</dt><dd>{m.def}</dd></>))}
        </dl>
      )}
      {notions.length > 0 && (
        <p class="mots-notions">
          <span class="mots-notions-label">À maîtriser aussi</span>
          {notions.map(n => (
            <a class="mots-puce" href={u('/ressources/lexique#consolidation')}>
              {n.nom}{n.symbole && <em>{n.symbole}</em>}
            </a>
          ))}
        </p>
      )}
      <p class="mots-lien"><a href={u('/ressources/lexique')}>Tout le lexique →</a></p>
    </section>
  )}

  {pourAllerPlusLoin.length > 0 && (
    <section class="plus-loin" aria-labelledby="plus-loin-titre">
      <h2 id="plus-loin-titre">Pour revoir cette notion</h2>
      <ul>
        {pourAllerPlusLoin.map(s => (
          <li>
            <a href={s.url} rel="noopener external" target="_blank">
              {s.nom}<span class="simu-fleche" aria-hidden="true">↗</span>
            </a>
            <p>{s.desc}</p>
            <p class="simu-meta">
              {s.source}
              {s.navigateur
                ? <span class="simu-tag">en ligne</span>
                : <span class="simu-tag simu-tag--install">à installer</span>}
            </p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="qr">
    <img src={u(d.qr)} alt={`QR code vers l'activité ${d.code} ${d.niveauLabel}`} width="76" height="76" loading="lazy" />
    <p>
      Ce QR code est imprimé sur la fiche papier.<br />
      Il ramène directement à cette page.
    </p>
  </section>

  <nav class="suite" aria-label="Activités voisines dans la séquence">
    {prec
      ? <a class="suite-lien" rel="prev" href={u(`/${prec.data.annee}/${prec.data.seq}/${prec.id}`)}>
          <span class="suite-dir">← Étape {rang - 1} · {prec.data.phase}</span>
          <span class="suite-titre">{prec.data.titre}</span>
        </a>
      : <span></span>}
    {suiv
      ? <a class="suite-lien suite-lien--droite" rel="next" href={u(`/${suiv.data.annee}/${suiv.data.seq}/${suiv.id}`)}>
          <span class="suite-dir">Étape {rang + 1} · {suiv.data.phase} →</span>
          <span class="suite-titre">{suiv.data.titre}</span>
        </a>
      : <span></span>}
  </nav>

</Base>
