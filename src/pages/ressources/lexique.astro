---
// Lexique & consolidation.
//
// Deux contenus de nature différente sur une même page, et c'est voulu : quand
// un élève bute sur un mot, il ne sait pas d'avance si c'est du vocabulaire de
// Technologie (« actionneur ») ou une notion de maths qui lui manque (« 1 m²
// ne fait pas 100 cm² »). Il cherche au même endroit.
//
// Ils restent visuellement distincts — la consolidation a son propre bandeau,
// ses tableaux d'unités et ses encadrés « piège » — et les thèmes sont repliés
// par défaut (<details>, sans JavaScript) pour que la page tienne à l'écran.
// À l'impression, tout s'ouvre : c'est le mémo qu'on colle dans le cahier.

import Base from '../../layouts/Base.astro';
import { lexique, lexiquePdf, lexiqueDocx, nbTermes } from '../../data/ressources';
import { consolidation, nbNotions, conversions } from '../../data/consolidation';
import { statSync } from 'node:fs';
import path from 'node:path';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = p => base + p;

// Deux entrées pour un même lexique, parce qu'elles répondent à deux questions
// différentes : les THÈMES pour apprendre (les mots d'un même thème
// s'éclairent l'un l'autre), l'ORDRE ALPHABÉTIQUE pour retrouver un mot dont
// on ne sait plus à quel thème il appartient — ce qui est le cas le plus
// fréquent quand on relit sa fiche.
const idDe = (mot) => 'mot-' + String(mot)
  .toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')
  .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const tousLesMots = lexique
  .flatMap(sec => sec.termes.map(([mot]) => ({ mot, theme: sec.titre })))
  .sort((x, y) => x.mot.localeCompare(y.mot, 'fr'));

const parLettre = tousLesMots.reduce((acc, m) => {
  const l = m.mot.normalize('NFD').replace(/[̀-ͯ]/g, '')[0].toUpperCase();
  (acc[l] ||= []).push(m);
  return acc;
}, {});
const lettres = Object.keys(parLettre).sort();
function poids(rel) {
  try {
    const o = statSync(path.join(process.cwd(), 'public', rel)).size;
    return o >= 1048576 ? (o / 1048576).toFixed(1).replace('.', ',') + ' Mo'
                        : Math.max(1, Math.round(o / 1024)) + ' Ko';
  } catch { return null; }
}
const pPdf = poids(lexiquePdf), pDocx = poids(lexiqueDocx);

const urlPage = new URL(u('/ressources/lexique/'), Astro.site).href;
const donneesLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Lexique de Technologie — Cycle 4 & Brevet',
  url: urlPage,
  inLanguage: 'fr',
  hasDefinedTerm: [
    ...lexique.flatMap(s => s.termes.map(([mot, def]) => ({
      '@type': 'DefinedTerm', name: mot, description: def,
    }))),
    ...consolidation.flatMap(b => b.notions.map(n => ({
      '@type': 'DefinedTerm', name: n.nom + (n.symbole ? ` (${n.symbole})` : ''), description: n.def,
    }))),
  ],
};
---
<Base
  titre="Lexique & consolidation — Technologie cycle 4"
  description="Le vocabulaire de Technologie du cycle 4 et du Brevet, et les notions de maths et de physique-chimie nécessaires aux activités : unités, conversions, échelles, pourcentages.">

  <script type="application/ld+json" slot="tete" set:html={JSON.stringify(donneesLd)} />

  <nav class="fil" aria-label="Fil d'Ariane">
    <a href={u('/')}>Accueil</a> / <a href={u('/ressources')}>Ressources</a> / Lexique
  </nav>

  <section class="hero hero--court leve">
    <span class="eyebrow leve leve-1">Document ressource · cycle 4</span>
    <h1 class="leve leve-1">Lexique &amp; <em>consolidation</em></h1>
    <p class="leve leve-2">
      {nbTermes} mots de Technologie à savoir employer, et {nbNotions} notions de
      maths et de physique-chimie sans lesquelles les activités ne peuvent pas
      être faites. Ouvre le thème qui te concerne.
    </p>
    <div class="docs leve leve-3">
      <a class="btn btn--fort" href={u(lexiquePdf)} download>
        Lexique en PDF{pPdf && <span class="btn-meta">{pPdf}</span>}
      </a>
      <a class="btn" href={u(lexiqueDocx)} download>
        Version modifiable{pDocx && <span class="btn-meta">DOCX · {pDocx}</span>}
      </a>
      <button type="button" class="btn" id="lex-imprimer">
        Imprimer cette page<span class="btn-meta">tout déplié</span>
      </button>
    </div>
  </section>

  <!-- ---------- vocabulaire de Technologie ---------- -->
  <h2 class="lex-bandeau" id="lexique">
    Vocabulaire de Technologie<span>{nbTermes} mots · attendus au Brevet</span>
  </h2>

  <details class="lex-index">
    <summary>
      <span class="lex-index-titre">Chercher un mot par ordre alphabétique</span>
      <span class="lex-theme-meta">{tousLesMots.length} mots</span>
    </summary>
    <nav class="lex-alpha" aria-label="Index alphabétique">
      {lettres.map(l => (
        <div class="lex-alpha-groupe">
          <span class="lex-alpha-lettre" aria-hidden="true">{l}</span>
          <ul>
            {parLettre[l].map(m => (
              <li><a href={'#' + idDe(m.mot)}>{m.mot}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </details>

  <div class="lex-themes">
    {lexique.map((s, i) => (
      <details class="lex-theme" open={i === 0}>
        <summary>
          <span class="lex-theme-titre">{i + 1}. {s.titre}</span>
          <span class="lex-theme-meta">{s.repere} · {s.termes.length} mots</span>
        </summary>
        <dl class="lexique">
          {s.termes.map(([mot, def]) => (<><dt id={idDe(mot)}>{mot}</dt><dd>{def}</dd></>))}
        </dl>
      </details>
    ))}
  </div>

  <!-- ---------- consolidation maths / physique-chimie ---------- -->
  <h2 class="lex-bandeau lex-bandeau--conso" id="consolidation">
    Consolidation — maths &amp; physique-chimie<span>{nbNotions} notions · les bases à maîtriser</span>
  </h2>
  <p class="conso-intro">
    Ce ne sont pas des leçons d'une autre matière : ce sont les points précis sur
    lesquels on bute en Technologie. Convertir des millimètres, calculer une
    surface, appliquer une échelle, ajouter un pourcentage. Chaque notion donne
    un <strong>ordre de grandeur concret</strong> et, quand il y en a un, le
    <strong>piège</strong> dans lequel on tombe vraiment.
  </p>

  <div class="lex-themes">
    {consolidation.map(b => (
      <details class="lex-theme lex-theme--conso">
        <summary>
          <span class="lex-theme-titre">{b.titre}</span>
          <span class="lex-theme-meta">{b.repere} · {b.notions.length} notions</span>
        </summary>
        <div class="conso-corps">
          <p class="conso-chapeau">{b.intro}</p>
          {b.schema && (
            <figure class="conso-schema">
              <img src={u(b.schema)} alt={`Schéma — ${b.titre}`} loading="lazy" />
            </figure>
          )}
          <ul class="conso-liste">
            {b.notions.map(n => (
              <li>
                <p class="conso-nom">
                  {n.nom}{n.symbole && <code>{n.symbole}</code>}
                </p>
                <p class="conso-def">{n.def}</p>
                {n.repere && <p class="conso-repere"><span>Ordre de grandeur</span>{n.repere}</p>}
                {n.piege && <p class="conso-piege"><span>Piège</span>{n.piege}</p>}
              </li>
            ))}
          </ul>
        </div>
      </details>
    ))}
  </div>

  <!-- Les tableaux de conversion, dans la forme des manuels de technologie :
       c'est celle que les élèves reconnaissent, et un tableau se consulte
       pendant l'activité — une règle écrite en phrase ne se relit jamais. -->
  <h2 class="lex-bandeau lex-bandeau--conso" id="conversions">
    Tableaux de conversion<span>{conversions.length} tableaux · à garder sous la main</span>
  </h2>
  <p class="conso-intro">
    Chaque tableau porte <strong>sa</strong> règle de passage : × 10 pour les
    longueurs, × 100 pour les aires, × 1 000 pour les volumes, × 60 pour les
    durées. C'est la règle qu'on confond, jamais le nom des unités.
  </p>

  <div class="conv-liste">
    {conversions.map(t => (
      <section class="conv">
        <h3>{t.titre}</h3>
        <div class="conv-boite">
          <table class="conv-table">
            <thead>
              <tr>{t.unites.map(un => <th scope="col">{un}</th>)}</tr>
            </thead>
            <tbody>
              <tr>{t.unites.map(() => <td aria-hidden="true"></td>)}</tr>
            </tbody>
          </table>
        </div>
        <p class="conv-regle">{t.regle}</p>
        <ul class="conv-egalites">
          {t.egalites.map(e => <li>{e}</li>)}
        </ul>
        {t.piege && <p class="conso-piege"><span>Piège</span>{t.piege}</p>}
      </section>
    ))}
  </div>

  <nav class="res-suite">
    <a class="btn" href={u('/ressources/syntheses')}>Fiches de synthèse →</a>
    <a class="btn" href={u('/ressources/animations')}>Animations &amp; logiciels →</a>
  </nav>

  <script>
    // Un lien de l'index pointe vers un <dt> qui vit dans un <details> replié.
    // Tous les navigateurs ne l'ouvrent pas tout seuls : on le fait ici, puis
    // on met le mot en évidence une seconde, sinon on ne sait pas où on a
    // atterri dans une liste de soixante-dix définitions.
    function ouvrirVers(hash) {
      if (!hash || !hash.startsWith('#mot-')) return;
      const cible = document.querySelector(hash);
      if (!cible) return;
      let p = cible.parentElement;
      while (p) { if (p.tagName === 'DETAILS') p.open = true; p = p.parentElement; }
      cible.scrollIntoView({ block: 'center', behavior: 'smooth' });
      cible.classList.add('mot-vise');
      setTimeout(() => cible.classList.remove('mot-vise'), 1600);
    }
    document.querySelectorAll('.lex-alpha a').forEach(a => {
      a.addEventListener('click', e => { e.preventDefault();
        history.replaceState(null, '', a.getAttribute('href'));
        ouvrirVers(a.getAttribute('href')); });
    });
    if (location.hash) ouvrirVers(location.hash);
  </script>

  <script>
    // Impression : tout déplier d'abord, sinon un thème replié s'imprime
    // replié et le mémo collé dans le cahier est vide.
    const bouton = document.getElementById('lex-imprimer');
    if (bouton) {
      const tout = () => document.querySelectorAll('details.lex-theme');
      bouton.addEventListener('click', () => {
        tout().forEach(d => d.open = true);
        window.print();
      });
      // Ctrl+P direct : même précaution.
      window.addEventListener('beforeprint', () => tout().forEach(d => d.open = true));
    }
  </script>


  <section class="qr">
    <img src={u('/qr/ressources-lexique.png')} alt="QR code vers le lexique" width="76" height="76" loading="lazy" />
    <p>
      <strong>Le lexique, en QR code.</strong><br />
      Il est imprimé sur le lexique papier et ramène directement ici.
    </p>
  </section>

</Base>
