---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const acts = await getCollection('activites');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const niveaux = [
  {
    id: '5eme', label: '5ème',
    // cube isométrique : la modélisation 3D, cœur de la séquence Conception
    icone: '<path d="M20 6 32 13 32 27 20 34 8 27 8 13Z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/><path d="M20 20V6M20 20 32 27M20 20 8 27" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/>',
  },
  {
    id: '4eme', label: '4ème',
    // tête de robot : écho direct au mBot de la séquence MEI
    icone: '<path d="M20 12V8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="20" cy="6.5" r="1.6" stroke="currentColor" stroke-width="1.6" fill="none"/><rect x="9" y="12" width="22" height="18" rx="4" stroke="currentColor" stroke-width="1.6" fill="none"/><rect x="5.5" y="17.5" width="3.5" height="7" rx="1.4" stroke="currentColor" stroke-width="1.6" fill="none"/><rect x="31" y="17.5" width="3.5" height="7" rx="1.4" stroke="currentColor" stroke-width="1.6" fill="none"/><circle cx="15.5" cy="20.5" r="2" fill="currentColor"/><circle cx="24.5" cy="20.5" r="2" fill="currentColor"/><path d="M15 26.5h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
  },
];

function resume(niveauId) {
  const items = acts.filter(a => a.data.niveau === niveauId);
  const nbSequences = new Set(items.map(a => a.data.seq)).size;
  return { nbActivites: items.length, nbSequences };
}

const donneesLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Académie Technologique',
  url: new URL(base + '/', Astro.site).href,
  description: "Fiches d'activité de Technologie, cycle 4, programme 2024. Collège d'Auteuil, Nouvelle-Calédonie.",
  inLanguage: 'fr',
  publisher: {
    '@type': 'EducationalOrganization',
    name: "Collège d'Auteuil",
    address: { '@type': 'PostalAddress', addressRegion: 'Nouvelle-Calédonie', addressCountry: 'FR' },
  },
};
---
<Base
  titre="Académie Technologique — Technologie au collège, Nouvelle-Calédonie"
  description="Fiches d'activité de Technologie, cycle 4, programme 2024. Collège d'Auteuil, Nouvelle-Calédonie.">

  <script type="application/ld+json" slot="tete" set:html={JSON.stringify(donneesLd)} />

  <section class="hero leve">
    <span class="eyebrow leve leve-1">Académie Technologique</span>
    <h1 class="leve leve-1">Toutes tes fiches de <em>Technologie</em></h1>
    <p class="leve leve-2">
      Le travail se fait en classe, sur la fiche papier. Ce site est là pour
      <strong>récupérer une fiche</strong> que tu as perdue, <strong>rattraper</strong>
      une séance manquée et <strong>voir la correction</strong>. Choisis ta classe.
    </p>
  </section>

  <div class="accueil-niveaux leve leve-3">
    {niveaux.map(n => {
      const r = resume(n.id);
      return (
        <a class="accueil-carte" href={`${base}/${n.id}`}>
          <svg class="accueil-icone" width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true" set:html={n.icone} />
          <span class="accueil-carte-titre">{n.label}</span>
          <span class="cote">
            <svg width="18" height="8" viewBox="0 0 18 8" aria-hidden="true"><path d="M0 4h18M0 4l3-2.5M0 4l3 2.5M18 4l-3-2.5M18 4l-3 2.5" stroke="currentColor" stroke-width="1" fill="none"/></svg>
            {r.nbSequences} séquence{r.nbSequences > 1 ? 's' : ''} · {r.nbActivites} activité{r.nbActivites > 1 ? 's' : ''}
          </span>
          <span class="aller" aria-hidden="true">→</span>
        </a>
      );
    })}
  </div>

  <!-- À quoi sert ce site, dit une fois et dans l'ordre d'importance réelle.
       Le remplissage en ligne existe toujours, mais il vient en dernier : en
       classe, c'est le papier qui entraîne l'écriture, et c'est l'écriture que
       le brevet demande. -->
  <section class="accueil-roles leve leve-3">
    <h2>À quoi sert ce site</h2>
    <ol class="roles">
      <li>
        <span class="roles-num">1</span>
        <div>
          <h3>Récupérer une fiche</h3>
          <p>Chaque activité a sa fiche en PDF, prête à imprimer — la même qu'en classe.</p>
        </div>
      </li>
      <li>
        <span class="roles-num">2</span>
        <div>
          <h3>Rattraper une séance</h3>
          <p>Absent ? La page de l'activité dit ce qui a été fait, avec le matériel et l'objectif.</p>
        </div>
      </li>
      <li>
        <span class="roles-num">3</span>
        <div>
          <h3>Voir la correction</h3>
          <p>Le professeur donne un mot en fin de séance : il ouvre la correction de l'activité.</p>
        </div>
      </li>
    </ol>
    <p class="roles-note">
      Tu peux aussi <a href={base + '/mode-demploi'}>remplir une fiche en ligne</a> —
      c'est surtout utile pour rattraper à la maison. En classe, on écrit sur le papier.
    </p>
  </section>

  <!-- Le QR de l'accueil : celui qu'on projette en début d'année, qu'on colle
       dans le cahier et sur la porte de la salle. -->
  <section class="qr qr--accueil leve leve-3">
    <img src={base + '/qr/accueil.png'} alt="QR code vers l'accueil du site" width="112" height="112" loading="lazy" />
    <p>
      <strong>Le site, en QR code.</strong><br />
      À photographier une fois pour le retrouver toute l'année, sans taper d'adresse.
    </p>
  </section>
</Base>
